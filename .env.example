# Copy this file to .env to override the defaults below.
# No API key needed — the chatbot runs entirely on a local Ollama model.
# .env is gitignored.

# Optional: Ollama server address (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Optional: which local model to use (default: llama3.1:8b)
# Must be pulled first: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
